# Do not commit a real key. Copy these values into your local environment.
INTENT_LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
INTENT_LLM_MODEL=deepseek-reasoner
INTENT_LLM_API_KEY=replace-with-your-api-key
INTENT_LLM_TIMEOUT=60
# Optional: json_schema or json_object
INTENT_LLM_RESPONSE_FORMAT=json_object

# 模块二 video_understanding
# MediaPipe .task 模型文件目录（scripts/download_models.py 下载到这里）
VU_MODEL_DIR=data/models
# 语义状态/分析产物工作目录
VU_WORKSPACE_DIR=workspace
# 集成测试用的手势舞视频（data/ 不入库）
VU_TEST_VIDEO=data/test_video.mp4

# 模块三 editing_planner：LLM 创意规划接缝（不配则规则实现）
PLANNER_LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
PLANNER_LLM_MODEL=deepseek-reasoner
PLANNER_LLM_API_KEY=replace-with-your-api-key
PLANNER_LLM_TIMEOUT=60

# 模块四 asset_manager：LLM 查询改写接缝（不配则词表改写）
ASSET_LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
ASSET_LLM_MODEL=deepseek-reasoner
ASSET_LLM_API_KEY=replace-with-your-api-key
ASSET_LLM_TIMEOUT=60
# Optional: json_schema or json_object
ASSET_LLM_RESPONSE_FORMAT=json_object
# 在线素材源（JSON 数组；不配则仅 user/local 两级）
# ASSET_ONLINE_SOURCES=[{"adapter_id":"source_a","endpoint":"https://example.com/search","asset_types":["sticker","image","background"],"authorized_for_music":false,"headers":{"Authorization":"..."}}]
