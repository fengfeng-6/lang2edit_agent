# Do not commit a real key. Copy these values into your local environment.
INTENT_LLM_BASE_URL=https://models.sjtu.edu.cn/api/v1
INTENT_LLM_MODEL=deepseek-reasoner
INTENT_LLM_API_KEY=replace-with-your-api-key
INTENT_LLM_TIMEOUT=60
# Optional: json_schema or json_object
INTENT_LLM_RESPONSE_FORMAT=json_object

# 模块二 video_understanding
# MediaPipe .task 模型文件目录（scripts/download_models.py 下载到这里）
VU_MODEL_DIR=data/models
# 语义状态/分析产物工作目录
VU_WORKSPACE_DIR=workspace
# 集成测试用的手势舞视频（data/ 不入库）
VU_TEST_VIDEO=data/test_video.mp4
